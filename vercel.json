{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "AWS_LAMBDA_JS_RUNTIME": "nodejs22.x"
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "legacy-waiver.tavarios.ca"
        }
      ],
      "destination": "/waiver-browser-kiosk/index.html"
    },
    {
      "source": "/waiver-browser-kiosk",
      "destination": "/waiver-browser-kiosk/index.html"
    },
    {
      "source": "/waiver-browser-kiosk/",
      "destination": "/waiver-browser-kiosk/index.html"
    },
    {
      "source": "/task-manager-kiosk",
      "destination": "/task-manager-kiosk/index.html"
    },
    {
      "source": "/task-manager-kiosk/",
      "destination": "/task-manager-kiosk/index.html"
    },
    {
      "source": "/legacy-punchclock",
      "destination": "/legacy-punchclock/index.html"
    },
    {
      "source": "/legacy-punchclock/",
      "destination": "/legacy-punchclock/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "task-manager.tavarios.ca"
        }
      ],
      "destination": "/task-manager-kiosk/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "task-manager.tavarios.ca"
        }
      ],
      "destination": "/task-manager-kiosk/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "clover-waivers.tavarios.ca"
        }
      ],
      "destination": "/clover-waivers/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "clover-waivers.tavarios.ca"
        }
      ],
      "destination": "/clover-waivers/index.html"
    },
    {
      "source": "/vending/download",
      "destination": "/vending-tablet-download/index.html"
    },
    {
      "source": "/vending/download/",
      "destination": "/vending-tablet-download/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "clover-waivers.tavarios.ca"
        }
      ],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.clover.com https://clover.com https://*.dev.clover.com https://sandbox.dev.clover.com https://www.clover.com https://www.eu.clover.com https://www.la.clover.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "clover-waivers.tavarios.ca"
        }
      ],
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/vending/download",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vending-tablet-download/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/legacy-punchclock/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "legacy-punchclock.tavarios.ca"
        }
      ],
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}